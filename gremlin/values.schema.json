  "$defs": {
    "selinuxoptions.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "schemas/selinuxoptions.json",
      "title": "SELinuxOptions",
      "description": "SELinux options applied to the Gremlin agent container's securityContext. Only `type` is recommended; the others may relabel paths on the host filesystem, including container runtime sockets and container state directories.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "level": {
          "description": "SELinux level label (MLS/MCS).",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "SELinux role label.",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "description": "SELinux type label — the process label gremlind runs under. On BottleRocket, `super_t`.",
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "description": "SELinux user label.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
