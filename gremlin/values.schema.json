            },
            "readOnlyRootFilesystem": {
              "type": "boolean"
            },
            "seLinuxOptions": {
              "$ref": "schemas/selinuxoptions.json",
              "type": [
                "object",
                "null"
              ]
            },
            "seccomp": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "profile": {
                  "type": "string"
                },
                "root": {
                  "type": "string"
                }
              }
            },
            "securityContextConstraints": {
              "type": "object",
              "properties": {
                "allowHostDirVolumePlugin": {
                  "type": "boolean"
                },
                "create": {
                  "type": "boolean"
                },
                "runAsUser": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    }
                  }
                },
                "seLinuxContext": {
                  "type": "object",
                  "properties": {
                    "seLinuxOptions": {
                      "type": "object",
                      "properties": {
                        "level": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      }
                    },
                    "type": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "supplementalGroups": {
              "type": "object",
              "properties": {
                "rule": {
                  "type": "string"
                }
              }
            },
            "volumes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "priorityClassName": {
          "type": "string"
        },
        "proxy": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "secret": {
          "type": "object",
